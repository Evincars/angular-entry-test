{
  "name": "production-line",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/production-line/src",
  "tags": ["type:app", "scope:production-line"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/production-line",
        "browser": "apps/production-line/src/main.ts",
        "tsConfig": "apps/production-line/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/production-line/public"
          },
          {
            "glob": "machines.json",
            "input": "libs/production-line/data-access/src/assets",
            "output": "data"
          }
        ],
        "styles": [
          "node_modules/material-symbols/outlined.css",
          "apps/production-line/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/ui/src/styles"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "production-line:build:production"
        },
        "development": {
          "buildTarget": "production-line:build:development"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "production-line:build",
        "staticFilePath": "dist/apps/production-line/browser",
        "spa": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsc -p tsconfig.app.json --noEmit", "tsc -p tsconfig.spec.json --noEmit"],
        "parallel": false
      }
    }
  }
}
